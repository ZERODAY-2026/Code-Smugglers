SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=DATAMIND
SNOWFLAKE_SCHEMA=BANK_MARKETING
SNOWFLAKE_AUTHENTICATOR=OAUTH_AUTHORIZATION_CODE

# Optional overrides used by scripts/load_bank_marketing.py.
DATAMIND_DATABASE=DATAMIND
DATAMIND_SCHEMA=BANK_MARKETING
DATAMIND_DATASET=bank_marketing

# Required before POST /api/query can run.
GEMMA_PLANNER_MODULE=backend.person1_adapter
GEMMA_PLANNER_FUNCTION=plan_query
GEMMA_MODEL=gemma-4-26b-a4b-it
GOOGLE_GENAI_API_KEY=
GEMMA_PROVIDER=google_genai
GEMMA_SDK_RETRIES=2
GEMMA_SDK_RETRY_DELAY=2

# Browser origins allowed to call the API during local development.
DATAMIND_FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
